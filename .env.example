# React dev server port (Create React App)
PORT=3005
BROWSER=none

# Express API server port
SERVER_PORT=5000

# Google Gemini API key (used server-side by server/routes/aiRoutes.js)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Optional custom JWT signing secret (auto-generated in server/data/config.json if omitted)
# JWT_SECRET=replace_with_long_random_string
